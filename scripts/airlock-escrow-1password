#!/usr/bin/env python3
"""airlock-escrow-1password — 1Password Service Account escrow hook for Airlock.

Invoked automatically by `airlock-approver.py` during Day-0 target enrollment
when `BREAK_GLASS_ESCROW_CMD=/usr/local/bin/airlock-escrow-1password` is set:

    airlock-escrow-1password <target_hostname> <target_ip>   (private key on stdin)

Security properties:
- Reads the ed25519 private key strictly from stdin (never via CLI args).
- Passes the item payload to `op item create -` as JSON over stdin so the
  private key never appears in `/proc/<pid>/cmdline` or `ps aux`.
- Reads `OP_SERVICE_ACCOUNT_TOKEN` from the environment or from
  `AIRLOCK_OP_TOKEN_FILE` (default `/etc/airlock/op-service-account.token`).
- Fails closed (non-zero exit) if the token is missing, stdin is empty, or
  `op item create` fails, preventing `airlock-approver` from scrubbing the
  target's birth key unless 1Password has confirmed receipt.
"""

import json
import os
import subprocess
import sys
from datetime import datetime, timezone

OP_BIN = os.environ.get("AIRLOCK_OP_BIN", "op")
OP_VAULT = os.environ.get("AIRLOCK_OP_VAULT", "Homelab Break-Glass")
OP_TOKEN_FILE = os.environ.get(
    "AIRLOCK_OP_TOKEN_FILE", "/etc/airlock/op-service-account.token"
)


def load_token() -> str:
    token = os.environ.get("OP_SERVICE_ACCOUNT_TOKEN", "").strip()
    if token:
        return token
    if OP_TOKEN_FILE and os.path.isfile(OP_TOKEN_FILE):
        with open(OP_TOKEN_FILE, "r", encoding="utf-8") as fh:
            return fh.read().strip()
    return ""


def main() -> int:
    if len(sys.argv) != 3:
        print(
            "usage: airlock-escrow-1password <target_hostname> <target_ip>",
            file=sys.stderr,
        )
        return 2

    target = sys.argv[1].strip()
    target_ip = sys.argv[2].strip()
    if not target or not target_ip:
        print("error: target and target_ip must be non-empty", file=sys.stderr)
        return 2

    priv_key = sys.stdin.read()
    if "BEGIN OPENSSH PRIVATE KEY" not in priv_key:
        print(
            "error: stdin does not contain a valid OpenSSH private key",
            file=sys.stderr,
        )
        return 2

    token = load_token()
    if not token:
        print(
            f"error: OP_SERVICE_ACCOUNT_TOKEN not set and {OP_TOKEN_FILE} not found",
            file=sys.stderr,
        )
        return 2

    now_iso = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    item_payload = {
        "title": f"Airlock Break-Glass — {target} ({target_ip})",
        "category": "SECURE_NOTE",
        "tags": ["airlock", "break-glass", f"target:{target}"],
        "fields": [
            {
                "id": "notesPlain",
                "type": "STRING",
                "purpose": "NOTES",
                "label": "notesPlain",
                "value": (
                    f"Airlock Day-0 Escrowed Break-Glass SSH Private Key\n"
                    f"Target Hostname: {target}\n"
                    f"Target IP: {target_ip}\n"
                    f"Enrolled UTC: {now_iso}\n"
                ),
            },
            {
                "id": "target_hostname",
                "type": "STRING",
                "label": "Target Hostname",
                "value": target,
            },
            {
                "id": "target_ip",
                "type": "STRING",
                "label": "Target IP",
                "value": target_ip,
            },
            {
                "id": "ssh_private_key",
                "type": "CONCEALED",
                "label": "SSH Private Key (ed25519)",
                "value": priv_key,
            },
        ],
    }

    env = os.environ.copy()
    env["OP_SERVICE_ACCOUNT_TOKEN"] = token

    proc = subprocess.run(
        [OP_BIN, "item", "create", "--vault", OP_VAULT, "--format", "json", "-"],
        input=json.dumps(item_payload),
        capture_output=True,
        text=True,
        env=env,
        timeout=25,
    )
    if proc.returncode != 0:
        err = (proc.stderr or proc.stdout or "unknown op error").strip()
        print(f"error: op item create failed: {err}", file=sys.stderr)
        return 1

    try:
        created = json.loads(proc.stdout)
        item_id = created.get("id", "unknown")
    except Exception:
        item_id = "created"

    print(f"escrowed break-glass key for {target} ({target_ip}) to 1Password vault '{OP_VAULT}' (id={item_id})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
