#!/usr/bin/env bash
# Installed at /usr/local/libexec/airlock-set-host inside the Airlock VM (0755, root:root).
# Invoked by Proxmox qemu-guest-agent hookscript on boot and post-migration.
set -euo pipefail

HOST_NODE="${1:-}"
if [[ -z "$HOST_NODE" || ! "$HOST_NODE" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    echo "Usage: airlock-set-host <hypervisor-hostname>" >&2
    exit 1
fi

install -d -m 0755 -o root -g root /run/airlock
printf '%s\n' "$HOST_NODE" > /run/airlock/current-hypervisor.tmp
chmod 0444 /run/airlock/current-hypervisor.tmp
mv -f /run/airlock/current-hypervisor.tmp /run/airlock/current-hypervisor
