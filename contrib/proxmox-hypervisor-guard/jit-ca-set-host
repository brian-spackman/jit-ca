#!/usr/bin/env bash
# Installed at /usr/local/libexec/jit-ca-set-host inside the jit-ca VM (0755, root:root).
# Invoked by Proxmox qemu-guest-agent hookscript on boot and post-migration.
set -euo pipefail

HOST_NODE="${1:-}"
if [[ -z "$HOST_NODE" || ! "$HOST_NODE" =~ ^[a-zA-Z0-9._-]+$ ]]; then
    echo "Usage: jit-ca-set-host <hypervisor-hostname>" >&2
    exit 1
fi

install -d -m 0755 -o root -g root /run/jit-ca
printf '%s
' "$HOST_NODE" > /run/jit-ca/current-hypervisor.tmp
chmod 0444 /run/jit-ca/current-hypervisor.tmp
mv -f /run/jit-ca/current-hypervisor.tmp /run/jit-ca/current-hypervisor
