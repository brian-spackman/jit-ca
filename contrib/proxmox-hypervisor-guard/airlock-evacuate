#!/usr/bin/env bash
# Installed at /usr/local/libexec/airlock-evacuate inside the Airlock VM.
# Called by airlock-approver when an approved request targets the Proxmox node
# currently hosting the Airlock VM (`target == /run/airlock/current-hypervisor`).
#
# Reads /etc/airlock/proxmox-evacuate.conf:
#   PVE_VMID="1901"
#   PVE_PEER_MAP="optimuxprime:metroplex,metroplex:optimuxprime"
#   PVE_API_URL_optimuxprime="https://10.6.1.2:8006"
#   PVE_API_URL_metroplex="https://10.6.1.1:8006"
#   PVE_API_TOKEN="PVEAPIToken=airlock@pve!evacuate=..."
#   PVE_CACERT="/etc/airlock/certs/pve-root-ca.pem"   # optional CA bundle for PVE API
#   PVE_TLS_INSECURE="false"                          # set "true" only for self-signed PVE without CACERT
set -euo pipefail

RAW_TARGET="${1:-}"
TARGET_HOST="${RAW_TARGET,,}"
CONF="/etc/airlock/proxmox-evacuate.conf"

if [[ -z "$TARGET_HOST" || ! "$TARGET_HOST" =~ ^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$ ]]; then
    echo "missing or invalid target host" >&2
    exit 2
fi
if [[ ! -r "$CONF" ]]; then
    echo "missing $CONF" >&2
    exit 2
fi

# shellcheck source=/dev/null
source "$CONF"

# Resolve peer node for TARGET_HOST from PVE_PEER_MAP ("nodeA:nodeB,nodeB:nodeA")
PEER_NODE=""
IFS=',' read -ra PAIRS <<< "${PVE_PEER_MAP:-}"
for pair in "${PAIRS[@]}"; do
    src="${pair%%:*}"
    dst="${pair#*:}"
    if [[ "$src" == "$TARGET_HOST" ]]; then
        PEER_NODE="$dst"
        break
    fi
done

if [[ -z "$PEER_NODE" ]]; then
    echo "no peer hypervisor configured for $TARGET_HOST" >&2
    exit 3
fi

SAFE_HOST="${TARGET_HOST//[-.]/_}"
API_VAR="PVE_API_URL_${SAFE_HOST}"
API_URL="${!API_VAR:-}"
if [[ -z "$API_URL" || -z "${PVE_API_TOKEN:-}" || -z "${PVE_VMID:-}" ]]; then
    echo "incomplete PVE API settings for $TARGET_HOST in $CONF" >&2
    exit 4
fi

CURL_TLS_ARGS=()
if [[ -n "${PVE_CACERT:-}" && -r "${PVE_CACERT}" ]]; then
    CURL_TLS_ARGS+=(--cacert "${PVE_CACERT}")
elif [[ "${PVE_TLS_INSECURE:-false}" == "true" ]]; then
    CURL_TLS_ARGS+=(--insecure)
fi

# Trigger online live migration of the Airlock VM to PEER_NODE
# Pass Authorization header via stdin (--config -) so PVE_API_TOKEN never appears in /proc/<pid>/cmdline.
curl --fail --silent --show-error "${CURL_TLS_ARGS[@]}" \
    -X POST \
    --config - \
    --data-urlencode "target=${PEER_NODE}" \
    --data-urlencode "online=1" \
    --data-urlencode "with-local-disks=1" \
    "${API_URL}/api2/json/nodes/${TARGET_HOST}/qemu/${PVE_VMID}/migrate" >/dev/null <<EOF
header = "Authorization: ${PVE_API_TOKEN}"
EOF

# Wait up to 90s for post-migration hookscript (or self-update) to reflect PEER_NODE
for _ in $(seq 1 45); do
    if [[ -r /run/airlock/current-hypervisor ]]; then
        CUR="$(tr -d '[:space:]' < /run/airlock/current-hypervisor)"
        if [[ "$CUR" == "$PEER_NODE" ]]; then
            exit 0
        fi
    fi
    sleep 2
done

echo "timed out waiting for /run/airlock/current-hypervisor to become $PEER_NODE" >&2
exit 5
