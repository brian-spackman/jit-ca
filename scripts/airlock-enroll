#!/usr/bin/env python3
"""airlock-enroll — agent-side CLI to request Day-0 target enrollment in Airlock.

Publishes an enrollment request `{action: "enroll", req_id, target, target_ip, reason}`
to the ntfy request topic and blocks until the approver taps [Approve: Enroll & Lock]
and Airlock completes running `onboard-target.yml` using its private birth key
(generating & escrowing a per-target break-glass key, installing CA trust +
per-target principal, and wiping the birth key from the target).

  usage: airlock-enroll <target-hostname> <target-ip> <reason>
  e.g.:  airlock-enroll transcribe 10.6.31.1 "Onboard newly created transcribe LXC 3101"
"""

import ipaddress
import json
import re
import secrets
import sys
import time
from pathlib import Path
from urllib import request as urlrequest
from urllib.error import HTTPError, URLError

NTFY = "https://ntfy.example.net"
TOPIC_REQ = "airlock-requests"
TOPIC_CERT = "airlock-certs"
TOKEN_FILE = Path.home() / ".config/airlock/ntfy-agent-token"
TIMEOUT = 300
TARGET_NAME_RE = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$")


def die(msg, code=1):
    print(msg, file=sys.stderr)
    sys.exit(code)


def main():
    if len(sys.argv) != 4:
        die("usage: airlock-enroll <target-hostname> <target-ip> <reason>")
    target, target_ip, reason = sys.argv[1].strip(), sys.argv[2].strip(), sys.argv[3]
    if not TARGET_NAME_RE.match(target):
        die(f"invalid target hostname: {target!r}")
    try:
        ip_obj = ipaddress.ip_address(target_ip)
        if not ip_obj.is_private or ip_obj.is_loopback:
            die(f"target IP must be a private LAN/VLAN address: {target_ip!r}")
    except ValueError:
        die(f"invalid target IP address: {target_ip!r}")

    if not TOKEN_FILE.exists():
        die(f"missing agent ntfy token at {TOKEN_FILE}")
    token = TOKEN_FILE.read_text().strip()
    req_id = secrets.token_hex(8)

    request_json = json.dumps({
        "action": "enroll",
        "req_id": req_id,
        "target": target,
        "target_ip": str(ip_obj),
        "reason": reason,
    })
    payload = json.dumps({"topic": TOPIC_REQ, "message": request_json}).encode()
    req = urlrequest.Request(
        f"{NTFY}/", data=payload,
        headers={"Authorization": f"Bearer {token}",
                 "Content-Type": "application/json"}, method="POST")
    try:
        urlrequest.urlopen(req, timeout=15).read()
    except (HTTPError, URLError) as e:
        die(f"failed to publish enroll request: {e}")
    print(f"requested enrollment of {target} ({target_ip}) — waiting for approval "
          f"(tap 'Approve: Enroll & Lock' on your phone, {TIMEOUT//60} min timeout)...")

    deadline = time.time() + TIMEOUT
    poll_url = f"{NTFY}/{TOPIC_CERT}/json?poll=1&since=2m"
    while time.time() < deadline:
        try:
            preq = urlrequest.Request(
                poll_url, headers={"Authorization": f"Bearer {token}"})
            data = urlrequest.urlopen(preq, timeout=15).read().decode()
        except (HTTPError, URLError, OSError):
            time.sleep(2)
            continue
        for line in data.splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            if ev.get("event") != "message":
                continue
            try:
                body = json.loads(ev.get("message", ""))
            except json.JSONDecodeError:
                continue
            if body.get("req_id") != req_id or not body.get("enrolled"):
                continue
            print(f"enrolled — {body.get('target')} ({body.get('target_ip')}) locked to Airlock CA + break-glass key")
            print(f"Break-glass fingerprint: {body.get('fingerprint')}")
            return
        time.sleep(2)
    die("enrollment timed out — no confirmation received", 2)


if __name__ == "__main__":
    main()
