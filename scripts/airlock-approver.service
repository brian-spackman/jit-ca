[Unit]
Description=airlock-approver — out-of-band tap-to-sign approval & attestation daemon
After=network-online.target ntfy.service step-ca.service
Wants=network-online.target
Requires=ntfy.service step-ca.service

[Service]
Type=simple
User=step
Group=step
Environment="HOME=/tmp"
Environment="ANSIBLE_LOCAL_TEMP=/tmp/.ansible-tmp"
ExecStart=/usr/bin/python3 /usr/local/bin/airlock-approver
Restart=on-failure
RestartSec=5
# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
LogsDirectory=airlock
ReadOnlyPaths=/etc/airlock
ReadWritePaths=/var/log/airlock -/etc/airlock/secrets/break-glass -/etc/airlock/target-allowlist.txt
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
